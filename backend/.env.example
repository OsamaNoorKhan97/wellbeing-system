# Copy this file to .env and adjust the values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://wellbeing:wellbeing@localhost:5432/wellbeing
# Separate database used only by `npm test` (its data is wiped on every run)
TEST_DATABASE_URL=postgres://wellbeing:wellbeing@localhost:5432/wellbeing_test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

# Browser origin(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend, used to build password-reset links
APP_URL=http://localhost:5173

# Failed-login protection: max auth attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=30

# Optional: absolute or relative path to the built frontend (frontend/dist).
# When set, the API also serves the web app, so one process hosts everything.
FRONTEND_DIST=

# Used by `npm run db:seed` (password for all sample accounts) and `npm run create-admin`
SEED_PASSWORD=Password@123
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMPLOYEE_ID=
